PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DEFAULT_CLIENT_URL=http://localhost:5173

# Database & Cache
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/rit_esports?retryWrites=true&w=majority
REDIS_URL=redis://default:<password>@host:port

# Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters

# Email (Brevo)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
EMAIL_FROM=tournaments@yourdomain.com
EMAIL_FROM_NAME=Rahul Esports Arena

# Community & Admin Payment
ADMIN_WHATSAPP_NUMBER=919876543210
WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/your_community_id
ADMIN_UPI_ID=admin@upi
ADMIN_UPI_NAME=Admin Name
ADMIN_UPI_AID=uGICAgIDP-XXXXX
ADMIN_UPI_URI=upi://pay?pa=admin@upi&pn=Admin%20Name&aid=uGICAgIDP-XXXXX
QR_CODE_API_URL=https://api.qrserver.com/v1/create-qr-code/

# Initial Admin Bootstrap
ADMIN_BOOTSTRAP_EMAIL=admin@rahulesports.in
ADMIN_BOOTSTRAP_PASSWORD=ChangeThisPassword123!

SITE_NAME=Rahul Esports
SITE_REGION=Odisha
SITE_ANNOUNCEMENT=
CONTACT_EMAIL=

# Namespace shared Redis safely. Set trusted proxy hops to your hosting topology.
REDIS_KEY_PREFIX=rahul-arena:
CACHE_MAX_ENTRIES=1000
TRUST_PROXY_HOPS=0
